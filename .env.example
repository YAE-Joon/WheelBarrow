# 환경변수 템플릿 - 실제 값은 입력하지 말 것!

# App 설정
APP_NAME=Wheel Barrow
DEBUG=False
ENVIRONMENT=development

# Database 설정 (Docker 컨테이너용)
DATABASE_URL=postgresql://wheelbarrow_user:your_password@db:5432/wheelbarrow_prod

# Security (강력한 키로 변경 필요)
SECRET_KEY=your-very-secure-secret-key-here
JWT_SECRET_KEY=your-very-secure-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Server 설정
HOST=0.0.0.0
PORT=8000
RELOAD=False

# CORS (실제 도메인으로 변경)
CORS_ORIGINS=["https://yourdomain.com"]

# Logging
LOG_LEVEL=INFO